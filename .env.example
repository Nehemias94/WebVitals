# URL base de la API REST (Laravel 12). Incluye el prefijo /api.
API_BASE_URL=http://127.0.0.1:8000/api

# URL pública de este frontend (se usa para las URLs de retorno de Stripe).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: solo si tu API devuelve un `client_secret` (PaymentIntent) en lugar
# de una URL de Stripe Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Moneda y locale para mostrar precios.
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=es-MX

# Permite optimizar imágenes servidas desde 127.0.0.1/localhost (API local).
ALLOW_LOCAL_IMAGES=true
